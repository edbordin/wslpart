diff --git a/src/sys/scsi.c b/src/sys/scsi.c
index c03ddf9..754ad5e 100644
--- a/src/sys/scsi.c
+++ b/src/sys/scsi.c
@@ -43,6 +43,82 @@ static UCHAR SpdScsiErrorEx(PVOID Srb,
