<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="WinSpd">
  <Profiles>
    <SystemCollector Id="SchedulerCollector" Name="WinSpd Scheduler">
      <BufferSize Value="1024" />
      <Buffers Value="256" />
    </SystemCollector>
    <SystemProvider Id="SchedulerProvider">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="SampledProfile" />
        <Keyword Value="CSwitch" />
        <Keyword Value="ReadyThread" />
        <Keyword Value="DPC" />
        <Keyword Value="Interrupt" />
        <Keyword Value="CpuConfig" />
      </Keywords>
      <Stacks>
        <Stack Value="SampledProfile" />
        <Stack Value="CSwitch" />
        <Stack Value="ReadyThread" />
      </Stacks>
    </SystemProvider>
    <SystemProvider Id="SampledProvider">
      <Keywords>
        <Keyword Value="ProcessThread" />
        <Keyword Value="Loader" />
        <Keyword Value="SampledProfile" />
        <Keyword Value="DPC" />
        <Keyword Value="Interrupt" />
        <Keyword Value="CpuConfig" />
      </Keywords>
      <Stacks>
        <Stack Value="SampledProfile" />
      </Stacks>
    </SystemProvider>
    <Profile Id="WinSpdScheduler.Verbose.File" Name="WinSpdScheduler" Description="WinSpd worker CPU, ready time and DPC placement" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SchedulerCollector">
          <SystemProviderId Value="SchedulerProvider" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
    <Profile Id="WinSpdCpu.Verbose.File" Name="WinSpdCpu" Description="WinSpd CPU samples and DPC placement without scheduler stack walks" LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SchedulerCollector">
          <SystemProviderId Value="SampledProvider" />
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
