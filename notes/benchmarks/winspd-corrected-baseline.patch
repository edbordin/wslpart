+/* Correctness-only backport: FIFO FLUSH fence in the original ownership model. */
+static VOID SpdIoqRetireLogicalNoLock(SPD_IOQ *Ioq, SPD_SRB_EXTENSION *Extension)
+{
+    if (Extension->RingAccepted)
+    {
+        Ioq->RetiredSrbs++;
+        Extension->RingAccepted = FALSE;
+    }
+    if (!Extension->ExecutionStarted)
+        return;
+    if (Extension->RingIsFlush)
+        Ioq->FlushInProgress = FALSE;
+    else
+    {
+        ASSERT(0 != Ioq->ActiveSrbs);
+        Ioq->ActiveSrbs--;
+    }
+    Extension->ExecutionStarted = FALSE;
+}
+
+static BOOLEAN SpdIoqEligibleNoLock(SPD_IOQ *Ioq)
+{
+    if (Ioq->Stopped || Ioq->FlushInProgress || IsListEmpty(&Ioq->PendingList))
+        return FALSE;
+    SPD_SRB_EXTENSION *Head = CONTAINING_RECORD(Ioq->PendingList.Flink,
+        SPD_SRB_EXTENSION, ListEntry);
+    return !Head->RingIsFlush || 0 == Ioq->ActiveSrbs;
+}
